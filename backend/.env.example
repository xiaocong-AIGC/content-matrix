# Copy to .env and adjust for production. All optional (sensible dev defaults).

# Console (management API) auth — REQUIRED to access content/devices/broadcasts.
# Change this from the default before exposing the console.
ADMIN_TOKEN=douyin-admin-2026

# Pre-shared key a phone must send to register into the matrix. Empty = open
# (dev). Set it in prod, then provision phones with the same key:
#   python tools/provision_device.py --server ... --provision-key <KEY> ...
PROVISION_KEY=

# Allowed browser origins for the console (comma-separated), or * for LAN.
# Prefer the explicit console URL(s) in prod, e.g. http://192.168.1.50:3010
FRONTEND_ORIGIN=http://127.0.0.1:3010

# Database. SQLite is fine for dozens of phones; switch to Postgres for large
# scale / multiple uvicorn workers (then the claim uses FOR UPDATE SKIP LOCKED).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/douyin

# Lease / offline tuning
LEASE_SECONDS=120
DEVICE_OFFLINE_SECONDS=45
